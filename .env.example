# ---------------------------------------------------------------------------
# Local development / optional self-hosting (Docker Compose + Caddy).
#
# Copy this file to .env and fill in the required values. Never commit .env.
# For Render, use render.yaml instead: Render prompts for ADLEY_USERNAME and
# ADLEY_PASSWORD_HASH, generates ADLEY_SESSION_SECRET, injects PORT, and
# terminates HTTPS.
# ---------------------------------------------------------------------------

# Ignored on Render. Used only by the optional Caddy/VPS stack.
ADLEY_DOMAIN=ml.example.com
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Team sign-in (required)
# ---------------------------------------------------------------------------
# Choose your own login name. There is no default account.
ADLEY_USERNAME=

# Generate with: python3 scripts/hash_password.py
# The script prompts for a password and prints a PBKDF2-SHA256 hash.
# Keep the hash single-quoted in this file so Docker Compose does not treat
# "$..." as variable interpolation. In the Render Dashboard, paste it without
# the surrounding quotes.
ADLEY_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Session signing (required)
# ---------------------------------------------------------------------------
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. The app refuses to start otherwise.
ADLEY_SESSION_SECRET=

ADLEY_SESSION_MAX_AGE=43200
ADLEY_COOKIE_SECURE=true

# Compose/Caddy: true, because Caddy overwrites X-Forwarded-For with the
# real remote address. On Render the Blueprint sets this to false and sets
# ADLEY_TRUST_CLOUDFLARE=true instead.
ADLEY_TRUST_PROXY=true

# Set to true when Cloudflare is the edge (Render, or Cloudflare in front of
# Caddy). The app then prefers Cloudflare's overwritten CF-Connecting-IP for
# rate limiting instead of the caller-controlled leftmost X-Forwarded-For.
ADLEY_TRUST_CLOUDFLARE=false

# ---------------------------------------------------------------------------
# Rate limits (per client IP, in-memory, single app worker)
# ---------------------------------------------------------------------------
ADLEY_LOGIN_RATE_LIMIT=10
ADLEY_LOGIN_RATE_WINDOW=60
ADLEY_API_RATE_LIMIT=120
ADLEY_API_RATE_WINDOW=60
ADLEY_PAGE_RATE_LIMIT=600
ADLEY_PAGE_RATE_WINDOW=60
ADLEY_FAILED_LOGIN_LIMIT=5
ADLEY_FAILED_LOGIN_WINDOW=300
ADLEY_FAILED_LOGIN_BLOCK=300
